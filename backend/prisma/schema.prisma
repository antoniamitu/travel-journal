// backend/prisma/schema.prisma
// ============================================================
// Prisma Schema — AI-Integrated Geospatial Travel Journal
// ============================================================
// This schema covers all 5 tables defined in the PRDs.
//
// PostGIS note (IMPORTANT):
//   The `geog` column uses Unsupported("geography(Point, 4326)")
//   because Prisma has no native PostGIS support.
//
//   DB owns this column (computed/maintained DB-side):
//     - A DB trigger sets geog from latitude/longitude on INSERT/UPDATE.
//     - The DB enforces geog as NOT NULL.
//
//   Why is `geog` OPTIONAL in Prisma (`?`) if DB is NOT NULL?
//     - Because `Unsupported(...)` fields are not reliably writable from Prisma.
//     - Making it required can cause Prisma create/update payload validation issues.
//     - DB integrity is still guaranteed by the trigger + NOT NULL constraint.
//
//   Raw SQL is used for:
//     1. Creating/updating geog:
//          ST_SetSRID(ST_MakePoint(lng, lat), 4326)::geography
//     2. Spatial queries (bounding box):
//          ST_Intersects(geog, ST_MakeEnvelope(w, s, e, n, 4326)::geography)
//        IMPORTANT: ST_MakeEnvelope returns geometry, so ::geography cast is required.
//     3. GIST index on geog (created in raw SQL migration)
//     4. Functional index on LOWER(username) (created in raw SQL migration)
//
// After running `prisma migrate dev`, apply the PostGIS migration:
//   See file: prisma/sql/00_postgis_setup.sql
//
// CASCADE chain:
//   Delete User → CASCADE → Delete all user's Posts → CASCADE → Delete all post_images
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============================================================
// 1. USERS (PRD 1 — Authentication)
// ============================================================
model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(255)
  username      String   @unique @db.VarChar(20)
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamptz()
  updated_at    DateTime @updatedAt @db.Timestamptz()

  // Relations
  posts Post[]

  // Indexes
  // - email: UNIQUE (automatic from @unique)
  // - username: UNIQUE (automatic from @unique)
  // - LOWER(username) functional index: created in raw SQL migration
  // - created_at: for timestamp queries
  @@index([created_at])
  @@map("users")
}

// ============================================================
// 2. POSTS (PRD 3 — Post Management)
// ============================================================
model Post {
  id            Int     @id @default(autoincrement())
  user_id       Int
  title         String  @db.VarChar(100)
  content       String  @db.Text
  latitude      Float   @db.DoublePrecision
  longitude     Float   @db.DoublePrecision
  location_name String  @db.VarChar(500)
  city          String? @db.VarChar(100)
  country       String? @db.VarChar(100)

  // Automatic place classification
  // Kept as string for migration safety and easier iteration.
  // Allowed values will be enforced in application code.
  place_category String @default("other") @db.VarChar(30)

  // Stored OSM metadata used internally for classification, debugging,
  // and future backfill/reclassification without re-geocoding.
  osm_class    String? @db.VarChar(50)
  osm_subtype  String? @db.VarChar(100)
  address_type String? @db.VarChar(50)

  sentiment  String   @db.VarChar(20)
  sentiment_score Decimal? @db.Decimal(4, 2)
  privacy    String   @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  // PostGIS geography column — maintained by DB trigger (NOT set by Prisma)
  // ST_SetSRID(ST_MakePoint(longitude, latitude), 4326)::geography
  // NOTE: longitude first, then latitude (PostGIS point order)
  //
  // Prisma keeps this optional because Unsupported fields are not reliably writable.
  // DB still enforces NOT NULL on geog.
  geog Unsupported("geography(Point, 4326)")?

  // Relations
  user   User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  images PostImage[]

  // Indexes
  @@index([user_id])
  @@index([created_at])
  @@index([place_category])
  @@map("posts")
}

// ============================================================
// 3. POST IMAGES (PRD 3 — Image Management)
// ============================================================
model PostImage {
  id            Int      @id @default(autoincrement())
  post_id       Int
  secure_url    String   @db.VarChar(500)
  public_id     String   @unique @db.VarChar(200)
  display_order Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz()

  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id])
  @@map("post_images")
}

// ============================================================
// 4. GEOCODE CACHE (PRD 2 — Geocoding)
// ============================================================
model GeocodeCache {
  id           Int      @id @default(autoincrement())
  cache_key    String   @db.VarChar(500)
  cache_type   String   @db.VarChar(20)
  results_json Json     @db.JsonB
  created_at   DateTime @default(now()) @db.Timestamptz()

  @@unique([cache_key, cache_type])
  @@index([cache_key, cache_type, created_at])
  @@index([created_at])
  @@map("geocode_cache")
}

// ============================================================
// 5. AI CONTENT CACHE (PRD 4 — AI Integration)
// ============================================================
model AiContentCache {
  id           Int      @id @default(autoincrement())
  location_key String   @unique @db.VarChar(500)
  content      String   @db.Text
  created_at   DateTime @default(now()) @db.Timestamptz()

  @@index([created_at])
  @@map("ai_content_cache")
}
